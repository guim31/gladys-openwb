{
  "manifest_version": 1,
  "type": "device",
  "name": "openWB",
  "description": {
    "en": "The openWB 2 wallbox in local MQTT: charging state, power, modes, solar, grid and battery.",
    "fr": "La borne openWB 2 en MQTT local : état de charge, puissance, modes, solaire, réseau et batterie.",
    "de": "Die openWB 2 Wallbox lokal per MQTT: Ladezustand, Leistung, Modi, PV, Netz und Batterie.",
    "es": "El cargador openWB 2 por MQTT local: estado de carga, potencia, modos, solar, red y batería."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/guim31/gladys-openwb:1.0.0",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-openwb/main/cover.png",
  "categories": ["energy"],
  "transports": ["local"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Connect your openWB",
        "fr": "Connecter votre openWB",
        "de": "Verbinde deine openWB",
        "es": "Conecte su openWB"
      },
      "description": {
        "en": "The integration reads openWB 2.x through its MQTT broker, on your network. In openWB, under System → Sicherheit, allow unencrypted access (port 1883), or use port 8883 with TLS (required with user management). Changing modes and currents is off by default: Stop is always allowed.",
        "fr": "L'intégration lit l'openWB 2.x par son broker MQTT, sur votre réseau. Dans l'openWB, sous System → Sicherheit, autorisez l'accès non chiffré (port 1883), ou utilisez le port 8883 avec TLS (obligatoire avec la gestion des utilisateurs). Le changement de mode et d'intensité est désactivé par défaut : l'arrêt reste toujours permis.",
        "de": "Die Integration liest die openWB 2.x über ihren MQTT-Broker in deinem Netz. Erlaube in der openWB unter System → Sicherheit den unverschlüsselten Zugang (Port 1883) oder nutze Port 8883 mit TLS (Pflicht mit Benutzerverwaltung). Modi und Ströme zu ändern ist standardmäßig aus: Stop geht immer.",
        "es": "La integración lee openWB 2.x por su broker MQTT, en su red. En openWB, en System → Sicherheit, permita el acceso sin cifrar (puerto 1883), o use el puerto 8883 con TLS (obligatorio con la gestión de usuarios). Cambiar modos e intensidades está desactivado por defecto: Parada siempre se permite."
      },
      "links": [
        {
          "url": "https://github.com/openWB/core/wiki",
          "label": {
            "en": "openWB documentation",
            "fr": "Documentation openWB",
            "de": "openWB-Dokumentation",
            "es": "Documentación de openWB"
          }
        }
      ]
    },
    {
      "key": "host",
      "type": "string",
      "label": {
        "en": "openWB address",
        "fr": "Adresse de l'openWB",
        "de": "Adresse der openWB",
        "es": "Dirección de openWB"
      },
      "placeholder": {
        "en": "e.g. 192.168.1.30",
        "fr": "ex. 192.168.1.30",
        "de": "z. B. 192.168.1.30",
        "es": "p. ej. 192.168.1.30"
      },
      "description": {
        "en": "IP address or host name of the openWB (its broker runs on it).",
        "fr": "Adresse IP ou nom d'hôte de l'openWB (son broker tourne dessus).",
        "de": "IP-Adresse oder Hostname der openWB (ihr Broker läuft darauf).",
        "es": "Dirección IP o nombre de host de openWB (su broker funciona en ella)."
      },
      "required": true,
      "default": ""
    },
    {
      "key": "port",
      "type": "number",
      "label": {
        "en": "MQTT port",
        "fr": "Port MQTT",
        "de": "MQTT-Port",
        "es": "Puerto MQTT"
      },
      "description": {
        "en": "1883 unencrypted, 8883 with TLS.",
        "fr": "1883 sans chiffrement, 8883 avec TLS.",
        "de": "1883 unverschlüsselt, 8883 mit TLS.",
        "es": "1883 sin cifrar, 8883 con TLS."
      },
      "required": false,
      "default": 1883,
      "min": 1,
      "max": 65535
    },
    {
      "key": "tls",
      "type": "boolean",
      "label": {
        "en": "TLS (port 8883)",
        "fr": "TLS (port 8883)",
        "de": "TLS (Port 8883)",
        "es": "TLS (puerto 8883)"
      },
      "description": {
        "en": "The self-signed certificate of openWB is accepted.",
        "fr": "Le certificat auto-signé de l'openWB est accepté.",
        "de": "Das selbstsignierte Zertifikat der openWB wird akzeptiert.",
        "es": "Se acepta el certificado autofirmado de openWB."
      },
      "required": false,
      "default": false
    },
    {
      "key": "username",
      "type": "string",
      "label": {
        "en": "MQTT user (optional)",
        "fr": "Utilisateur MQTT (facultatif)",
        "de": "MQTT-Benutzer (optional)",
        "es": "Usuario MQTT (opcional)"
      },
      "description": {
        "en": "Only if the user management of openWB is on.",
        "fr": "Seulement si la gestion des utilisateurs de l'openWB est active.",
        "de": "Nur wenn die Benutzerverwaltung der openWB aktiv ist.",
        "es": "Solo si la gestión de usuarios de openWB está activa."
      },
      "required": false,
      "default": ""
    },
    {
      "key": "password",
      "type": "secret",
      "label": {
        "en": "MQTT password (optional)",
        "fr": "Mot de passe MQTT (facultatif)",
        "de": "MQTT-Passwort (optional)",
        "es": "Contraseña MQTT (opcional)"
      },
      "required": false
    },
    {
      "key": "allow_control",
      "type": "boolean",
      "label": {
        "en": "Allow control",
        "fr": "Autoriser le pilotage",
        "de": "Steuerung erlauben",
        "es": "Permitir el control"
      },
      "description": {
        "en": "Lets Gladys change the charging mode and the instant charging current. Stop is always allowed.",
        "fr": "Permet à Gladys de changer le mode de charge et l'intensité en charge immédiate. L'arrêt reste toujours permis.",
        "de": "Erlaubt Gladys, Lademodus und Strom für Sofortladen zu ändern. Stop geht immer.",
        "es": "Permite a Gladys cambiar el modo de carga y la intensidad de carga inmediata. Parada siempre se permite."
      },
      "required": false,
      "default": false
    },
    {
      "key": "language",
      "type": "select",
      "label": {
        "en": "Language of the feature names",
        "fr": "Langue des noms de fonctionnalités",
        "de": "Sprache der Funktionsnamen",
        "es": "Idioma de los nombres de funciones"
      },
      "required": false,
      "default": "fr",
      "options": [
        {
          "value": "en",
          "label": {
            "en": "English",
            "fr": "Anglais",
            "de": "Englisch",
            "es": "Inglés"
          }
        },
        {
          "value": "fr",
          "label": {
            "en": "French",
            "fr": "Français",
            "de": "Französisch",
            "es": "Francés"
          }
        },
        {
          "value": "de",
          "label": {
            "en": "German",
            "fr": "Allemand",
            "de": "Deutsch",
            "es": "Alemán"
          }
        },
        {
          "value": "es",
          "label": {
            "en": "Spanish",
            "fr": "Espagnol",
            "de": "Spanisch",
            "es": "Español"
          }
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "test_connection",
      "label": {
        "en": "Test the connection",
        "fr": "Tester la connexion",
        "de": "Verbindung testen",
        "es": "Probar la conexión"
      },
      "timeout_seconds": 20
    }
  ],
